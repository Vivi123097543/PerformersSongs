<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PerformersSongs.Application.DTOs;assembly=PerformersSongs.Application"
             xmlns:vm="clr-namespace:PerformersSongs.Presentation.ViewModels"
             x:Class="PerformersSongs.Presentation.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Исполнители песен">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Исполнители песен"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Выберите исполнителя:"
                   FontSize="16"
                   FontAttributes="Bold" />

            <Picker x:Name="PerformersPicker"
                    Title="Выберите исполнителя"
                    ItemsSource="{Binding Performers}"
                    SelectedItem="{Binding SelectedPerformer}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:PerformerDto}" />

            <Border Stroke="#D0D0D0"
                    StrokeThickness="1"
                    Padding="15"
                    StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="8">

                    <Label Text="Информация об исполнителе"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Image Source="{Binding SelectedPerformer.PhotoPath}"
                           HeightRequest="180"
                           WidthRequest="180"
                           Aspect="AspectFill"
                           HorizontalOptions="Center">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image"
                                         Binding="{Binding SelectedPerformer.PhotoPath}"
                                         Value="{x:Null}">
                                <Setter Property="IsVisible"
                                        Value="False" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label Text="{Binding SelectedPerformer.Name, TargetNullValue='Исполнитель не выбран'}"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SelectedPerformer.Country, StringFormat='Страна: {0}'}"
                           FontSize="14" />

                    <Label Text="{Binding SelectedPerformer.Genre, StringFormat='Жанр: {0}'}"
                           FontSize="14" />

                    <Label Text="{Binding SelectedPerformer.FoundationDate, StringFormat='Основан: {0:dd.MM.yyyy}'}"
                           FontSize="14" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Добавить исполнителя"
                    Clicked="OnAddPerformerClicked"
                    BackgroundColor="#287A4B"
                    TextColor="White" />

            <Button Text="Редактировать исполнителя"
                    Clicked="OnEditPerformerClicked"
                    BackgroundColor="#287A4B"
                    TextColor="White" />

            <Button Text="Удалить исполнителя"
                    Clicked="OnDeletePerformerClicked"
                    BackgroundColor="#CC3333"
                    TextColor="White" />

            <Button Text="Добавить песню"
                    Clicked="OnAddSongClicked" />

            <Label Text="Песни исполнителя"
                   FontSize="20"
                   FontAttributes="Bold" />

            <CollectionView x:Name="SongsCollection"
                            ItemsSource="{Binding Songs}"
                            SelectionMode="Single"
                            SelectionChanged="OnSongSelected">

                <CollectionView.EmptyView>
                    <Label Text="Выберите исполнителя, чтобы увидеть его песни"
                           HorizontalOptions="Center"
                           Margin="10" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SongDto">

                        <Border Stroke="#D0D0D0"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,5"
                                StrokeShape="RoundRectangle 10">

                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsBelowTopTen}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="#FFD6D6" />
                                    <Setter Property="Stroke"
                                            Value="#CC3333" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="5">

                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding ChartPosition, StringFormat='Место в чарте: {0}'}"
                                       FontSize="14" />

                                <Label Text="{Binding ReleaseYear, StringFormat='Год выпуска: {0}'}"
                                       FontSize="14" />

                                <Label Text="{Binding Duration, StringFormat='Продолжительность: {0}'}"
                                       FontSize="14" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Красным выделены песни, занимающие места ниже 10-го в чарте."
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
