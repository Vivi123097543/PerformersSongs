<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PerformersSongs.Presentation.Pages.AddPerformerPage"
             Title="Добавление исполнителя">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="Новый исполнитель"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Название исполнителя"
                   FontAttributes="Bold" />

            <Entry x:Name="NameEntry"
                   Placeholder="Введите название исполнителя" />

            <Label Text="Страна"
                   FontAttributes="Bold" />

            <Entry x:Name="CountryEntry"
                   Placeholder="Введите страну" />

            <Label Text="Жанр"
                   FontAttributes="Bold" />

            <Entry x:Name="GenreEntry"
                   Placeholder="Введите жанр" />

            <Label Text="Дата основания"
                   FontAttributes="Bold" />

            <DatePicker x:Name="FoundationDatePicker"
                        Format="dd.MM.yyyy" />

            <Label Text="Фотография исполнителя"
                   FontAttributes="Bold" />

            <Image x:Name="PerformerImage"
                   HeightRequest="180"
                   WidthRequest="180"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Button x:Name="ChoosePhotoButton"
                    Text="Выбрать фотографию"
                    Clicked="OnChoosePhotoClicked" />

            <Button x:Name="AddButton"
                    Text="Добавить исполнителя"
                    Clicked="OnAddClicked" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center" />

            <Button x:Name="CancelButton"
                    Text="Отмена"
                    BackgroundColor="Gray"
                    TextColor="White"
                    Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
