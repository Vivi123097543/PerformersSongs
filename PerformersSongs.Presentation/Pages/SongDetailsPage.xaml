<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PerformersSongs.Presentation.Pages.SongDetailsPage"
             Title="Подробности песни">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label Text="Подробная информация"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               HorizontalOptions="Center"
                               Color="Blue" />

            <Border Stroke="#D0D0D0"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Название песни"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label x:Name="TitleLabel"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <BoxView HeightRequest="1"
                             Color="#D0D0D0" />

                    <Label Text="Место в чарте"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label x:Name="ChartPositionLabel"
                           FontSize="18" />

                    <Label Text="Год выпуска"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label x:Name="ReleaseYearLabel"
                           FontSize="18" />

                    <Label Text="Продолжительность"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label x:Name="DurationLabel"
                           FontSize="18" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Редактировать песню"
                    x:Name="EditButton"
                    Clicked="OnEditClicked" />

            <Button Text="Удалить песню"
                    x:Name="DeleteButton"
                    BackgroundColor="#CC3333"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
